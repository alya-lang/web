## Demo of the web framework package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "http" as http
import "../src/lib.alya" as web

function hello(ctx)
    return web::ctx_json_map(ctx, {"message": "Hello from web"})
end

function show_user(ctx)
    return web::ctx_text(ctx, "user:" + web::ctx_param(ctx, "id"), 200)
end

function missing(ctx)
    return web::ctx_json_map(ctx, {"error": "try /hello"}, 404)
end

function main()
    say "=== alya-lang/web Feature Tour ==="

    # 1. App with routes, groups, and middleware
    let app = web::app()
    app.get("/hello", hello)
    app.get("/users/:id", show_user)
    let api = app.group("/api")
    api.get("/status", hello)
    app.use_request_id().use_logger().use_keep_alive()
    app.not_found(missing)
    say "Routes: " + str(len(app.router.routes))

    # 2. Pure dispatch (no sockets): match, params, invoke
    let dctx = http::ctx_new(http::request_create("GET", "/users/7"), http::response())
    let m = web::app_dispatch(app, "GET", "/users/7", dctx)
    say "Dispatch found: " + str(m.found) + " Body: " + dctx.res.body

    # 3. Middleware materializes on the built server
    let srv = web::app_build_server(app, 18080, "127.0.0.1")
    say "Logger wired: " + str(srv.options["logger_enabled"])
    say "Keep-alive wired: " + str(srv.options["keep_alive_enabled"])

    # 4. Bounded serve with no client terminates cleanly
    http::server_start(srv)
    let served = web::serve(app, srv, 1, 300)
    say "Served (no client): " + str(served)
    http::server_close(srv)

    say "All alya-lang/web features operational!"
end

main()
