## Micro-benchmarks for the web framework package
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)
import "std/bench"
import "http" as http
import "../src/lib.alya" as web

function bench_hello(ctx)
    return web::ctx_text(ctx, "hi", 200)
end

function main()
    let runner = bench_runner("alya-lang/web Micro-Benchmarks")

    let app = web::app()
    let i = 0
    while i < 50
        app.get("/r" + str(i) + "/:id", bench_hello)
        i += 1
    end

    # 1. Route match throughput
    bench_start(runner, 20000)
    let j = 0
    while j < 20000
        web::app_match(app, "GET", "/r25/42")
        j += 1
    end
    bench_stop(runner, "App route match (50 routes)")

    # 2. Dispatch throughput (match + params + invoke)
    bench_start(runner, 20000)
    let k = 0
    while k < 20000
        let ctx = http::ctx_new(http::request_create("GET", "/r25/42"), http::response())
        web::app_dispatch(app, "GET", "/r25/42", ctx)
        k += 1
    end
    bench_stop(runner, "App dispatch with handler invoke")

    # 3. Cached view render throughput (compile once, render N)
    let ot = "{{"
    let ct = "}}"
    let tpl = "Hello, " + ot + "name" + ct + "!"
    bench_start(runner, 5000)
    let v = 0
    while v < 5000
        let vctx = http::ctx_new(http::request_create("GET", "/page"), http::response())
        web::view_cached(app, vctx, tpl, {"name": "Ada"})
        v += 1
    end
    bench_stop(runner, "Cached view render")

    bench_summary(runner)
end

main()
