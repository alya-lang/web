    self.options["auth_enabled"] = 1
    self.options["auth_kind"] = "bearer"
    self.options["auth_token"] = token
    return self
end

## Requires a valid JWT (method form).
pub function App.use_jwt_auth(self: App, secret: string)
    self.options["auth_enabled"] = 1
    self.options["auth_kind"] = "jwt"
    self.options["auth_secret"] = secret
    return self
end

## Throttles clients (method form).
pub function App.use_rate_limit(self: App, limit: int = 100, window_ms: int = 60000)
    self.options["rate_limit_enabled"] = 1
    self.options["rate_limit"] = limit
    self.options["rate_window_ms"] = window_ms
    return self
end

## Tags responses with request IDs (method form).
pub function App.use_request_id(self: App, enabled: int = 1)
    self.options["request_id_enabled"] = enabled
    return self
end

## Bounds socket I/O waits (method form).
pub function App.use_timeout(self: App, timeout_ms: int = 5000)
    self.options["timeout_ms"] = timeout_ms
    return self
end

## Caps request sizes (method form).
pub function App.use_limits(self: App, max_header_size: int = 1048576, max_body_size: int = 8388608)
    self.options["max_header_size"] = max_header_size
    self.options["max_body_size"] = max_body_size
    return self
end

## Reuses connections (method form).
pub function App.use_keep_alive(self: App, max_requests: int = 100)
    self.options["keep_alive_enabled"] = 1
    self.options["keep_alive_max"] = max_requests
    return self
end

## Trusts proxy headers (method form).
pub function App.use_forwarded(self: App, enabled: int = 1)
    self.options["forwarded_enabled"] = enabled
    return self
end

## Terminates TLS (method form).
pub function App.use_tls(self: App, cert_pem: string, key_pem: string)
    self.options["tls_enabled"] = 1
    self.options["tls_cert"] = cert_pem
    self.options["tls_key"] = key_pem
    return self
end
