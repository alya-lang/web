## web Types & Data Structures.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "http" as http

## High-level web application: an HTTP router plus framework settings.
##
## Build with `app()`, register routes (`app_get`, ... or `App.get`, ...),
## tune with `use_*`, then serve with `listen`. The underlying `http`
## server is assembled at listen time from these settings.
##
## ### Fields
## - `router`: Active `http` route registry.
## - `options`: Framework setting map (middleware toggles, handlers, limits).
pub struct App
    router,
    options: map
end

## Route group binding an App to a common path prefix.
##
## ### Fields
## - `app`: Owning application value.
## - `prefix`: Common path prefix string.
pub struct WebGroup
    app,
    prefix: string
end

## Creates a new App with default settings.
pub function app_new() -> App
    return App {
        router: http::router(),
        options: {
            "not_found": null,
            "on_error": null,
            "logger_enabled": 0,
            "log_format": "",
            "cors_enabled": 0,
            "cors_origin": "*",
            "cors_methods": "GET, POST, PUT, DELETE, OPTIONS, HEAD, PATCH, QUERY",
            "cors_headers": "Content-Type, Authorization, X-Requested-With",
            "compression_enabled": 0,
            "compression_min": 256,
            "static_enabled": 0,
            "static_prefix": "",
            "static_dir": "",
            "auth_enabled": 0,
            "auth_kind": "",
            "auth_user": "",
            "auth_pass": "",
            "auth_token": "",
            "auth_secret": "",
            "rate_limit_enabled": 0,
            "rate_limit": 100,
            "rate_window_ms": 60000,
            "request_id_enabled": 0,
            "timeout_ms": 5000,
            "max_header_size": 1048576,
            "max_body_size": 8388608,
            "keep_alive_enabled": 0,
            "keep_alive_max": 100,
            "forwarded_enabled": 0,
            "tls_enabled": 0,
            "tls_cert": "",
            "tls_key": ""
        }
    }
end

## Creates a new WebGroup attached to an App.
pub function group_new(app: App, prefix: string) -> WebGroup
    return WebGroup {
        app: app,
        prefix: prefix
    }
end
